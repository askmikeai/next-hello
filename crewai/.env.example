# NextHello CrewAI Configuration
# Copy to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Choose your LLM provider. Options:
# - anthropic/claude-sonnet-4-20250514 (recommended)
# - anthropic/claude-3-5-sonnet-20241022
# - anthropic/claude-3-opus-20240229
# - openai/gpt-4o
# - openai/gpt-4o-mini
# - gemini/gemini-2.0-flash
# - ollama/llama3.2 (local)
LLM_PROVIDER=anthropic/claude-sonnet-4-20250514

# API Keys (only need the one for your chosen provider)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# =============================================================================
# Event Configuration
# =============================================================================

OWNER_NAME="Michael"
EVENT_NAME="Tech Networking Mixer"

# =============================================================================
# WhatsApp Cloud API Configuration
# =============================================================================

# Get these from Meta Business Suite / WhatsApp Business Platform
# https://developers.facebook.com/apps/

# Your WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=...

# Permanent access token (System User token recommended)
WHATSAPP_ACCESS_TOKEN=...

# Webhook verification token (you create this, must match Meta config)
WHATSAPP_VERIFY_TOKEN=nexthello_verify

# App secret for webhook signature verification (optional but recommended)
WHATSAPP_APP_SECRET=...

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis URL for state management and job queue
REDIS_URL=redis://localhost:6379

# =============================================================================
# Frontend Configuration
# =============================================================================

# Path to the built frontend (after running npm run build in src/admin/frontend)
FRONTEND_DIR=/path/to/nexthello/dist/src/admin

# =============================================================================
# External Service API Keys
# =============================================================================

# People Data Labs (for contact enrichment)
PDL_API_KEY=...

# HeyGen (for video generation)
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...
HEYGEN_VOICE_ID=...

# ElevenLabs (for voice generation)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# HubSpot CRM
HUBSPOT_API_KEY=...

# =============================================================================
# Database Configuration
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=...

# =============================================================================
# Webhook Configuration (for HeyGen callbacks)
# =============================================================================

WEBHOOK_BASE_URL=https://your-domain.com
