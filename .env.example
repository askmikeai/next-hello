# NextHello Environment Configuration
# ====================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Option 1: Connection URL (takes precedence)
DATABASE_URL=postgresql://nexthello:nexthello_dev@localhost:5432/nexthello

# Option 2: Individual connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexthello
POSTGRES_USER=nexthello
POSTGRES_PASSWORD=nexthello_dev

# ===========================================
# AI Providers (At least one required)
# ===========================================
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Integrations (Optional but recommended)
# ===========================================
# HeyGen (AI Videos): https://app.heygen.com/settings
HEYGEN_API_KEY=

# ElevenLabs (AI Voice): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Calendly: https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=

# LinkedIn Data (ProxyCurl shut down - alternatives: Apollo, Clearbit, People Data Labs)
# LINKEDIN_API_KEY=

# HubSpot CRM: https://app.hubspot.com/api-key
HUBSPOT_API_KEY=

# Optional: OpenClaw Gateway over Tailscale (private)
OPENCLAW_BASE_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HOOKS_TOKEN=
OPENCLAW_TIMEOUT_SECONDS=120

# Backward compatibility relay endpoint (optional)
OPENCLAW_RESEARCH_URL=
OPENCLAW_HEALTH_URL=
OPENCLAW_API_KEY=

# Demo mode safety controls
# When true, server enforces filtered contact message content for demo endpoints
DEMO_MODE=false

# Moderation mode safety controls
# When true, inbound messages are recorded but no automatic replies are sent.
MODERATION_MODE=false

# SendGrid (Email): https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Telegram Bot: https://t.me/BotFather
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow instructions
# 3. Copy the bot token here
TELEGRAM_BOT_TOKEN=

# ===========================================
# App Configuration
# ===========================================
NEXTHELLO_OWNER_NAME=Your Name
NEXTHELLO_EVENT_NAME=Conference 2026
NEXTHELLO_CALENDLY_LINK=https://calendly.com/your-link

# Unprefixed aliases (read by Python agent code via os.getenv)
OWNER_NAME=Your Name
EVENT_NAME=Conference 2026
CALENDLY_URL=https://calendly.com/your-link
OWNER_ROLE=Your Role
OWNER_LOCATION=Your City
OWNER_INTERESTS=Your interests
OWNER_FAVORITE_PLACE=Your favorite place

# ===========================================
# Docker Configuration
# ===========================================
NEXTHELLO_PORT=3000
NEXTHELLO_IMAGE=nexthello:local

# Public URL for webhooks (ngrok, cloudflare tunnel, or production URL)
# HeyGen will call this URL when video generation is complete
# Example: https://your-domain.ngrok.io or https://nexthello.yourdomain.com
WEBHOOK_BASE_URL=

# Webhook signature verification (auto-generated by docker-setup.sh)
# Use this when configuring webhooks in HeyGen/Calendly
WEBHOOK_SECRET=

# ===========================================
# Optional: Override paths
# ===========================================
# NEXTHELLO_CONFIG=./nexthello.config.json

# Explicit system owner used when a trusted internal caller omits tenant headers.
# Requests should still set X-NextHello-User (or Basic Auth username) for tenant scoping.
NEXTHELLO_SYSTEM_OWNER_ID=askmikeai@gmail.com
