# NextHello Environment Configuration
# ====================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Option 1: Connection URL (takes precedence)
DATABASE_URL=postgresql://nexthello:nexthello_dev@localhost:5432/nexthello

# Option 2: Individual connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexthello
POSTGRES_USER=nexthello
POSTGRES_PASSWORD=nexthello_dev

# ===========================================
# AI Providers (At least one required)
# ===========================================
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Integrations (Optional but recommended)
# ===========================================
# HeyGen (AI Videos): https://app.heygen.com/settings
HEYGEN_API_KEY=

# ElevenLabs (AI Voice): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Calendly: https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=

# LinkedIn Data (ProxyCurl shut down - alternatives: Apollo, Clearbit, People Data Labs)
# LINKEDIN_API_KEY=

# HubSpot CRM: https://app.hubspot.com/api-key
HUBSPOT_API_KEY=

# SendGrid (Email): https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# ===========================================
# App Configuration
# ===========================================
NEXTHELLO_OWNER_NAME=Your Name
NEXTHELLO_EVENT_NAME=Conference 2026
NEXTHELLO_CALENDLY_LINK=https://calendly.com/your-link

# ===========================================
# Docker Configuration
# ===========================================
NEXTHELLO_PORT=3000
NEXTHELLO_IMAGE=nexthello:local

# Public URL for webhooks (ngrok, cloudflare tunnel, or production URL)
# HeyGen will call this URL when video generation is complete
# Example: https://your-domain.ngrok.io or https://nexthello.yourdomain.com
WEBHOOK_BASE_URL=

# Webhook signature verification (auto-generated by docker-setup.sh)
# Use this when configuring webhooks in HeyGen/Calendly
WEBHOOK_SECRET=

# ===========================================
# Optional: Override paths
# ===========================================
# NEXTHELLO_CONFIG=./nexthello.config.json