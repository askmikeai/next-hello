#!/usr/bin/env bash
#
# NextHello CLI - AI-powered networking assistant
#
# Usage:
#   ./nexthello <command>
#
# Commands:
#   start       Start all services (API + Worker + WhatsApp)
#   stop        Stop all services
#   status      Check health of all services
#   logs        View service logs
#   whatsapp    Connect WhatsApp (scan QR code)
#   whatsapp-test  Verify inbound persistence to PostgreSQL
#   whatsapp-session-test  Verify Baileys session persistence + restore
#   whatsapp-flow-test  Send outbound test message + verify DB
#   swarm-response-test  Simulate inbound and verify swarm response
#   model       Show/set active LLM provider
#   migrate     Run database migrations
#   build       Rebuild Docker images
#   shell       Open shell in API container
#   help        Show this help message
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Print colored output
info() { echo -e "${CYAN}▸${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; }

# Check if Docker is running
check_docker() {
    if ! docker info &> /dev/null; then
        error "Docker is not running. Please start Docker first."
        exit 1
    fi
}

# Main command handler
case "${1:-help}" in
    start)
        check_docker
        info "Starting NextHello..."
        docker compose up -d
        sleep 2
        docker compose exec api python cli.py status 2>/dev/null || true
        echo ""
        success "NextHello is running"
        echo ""
        echo "  API Docs:  http://localhost:8001/docs"
        echo ""
        ;;

    stop)
        check_docker
        info "Stopping NextHello..."
        docker compose down
        success "NextHello stopped"
        ;;

    restart)
        check_docker
        info "Restarting NextHello..."
        docker compose restart
        success "NextHello restarted"
        ;;

    status)
        check_docker
        docker compose exec api python cli.py status
        ;;

    model)
        shift || true
        ENV_FILE=".env"
        if [ ! -f "$ENV_FILE" ]; then
            error "Missing .env file in project root"
            exit 1
        fi

        if [ -z "${1:-}" ]; then
            CURRENT=$(python - "$ENV_FILE" <<'PY'
import re
import sys
path = sys.argv[1]
value = None
for line in open(path, encoding="utf-8", errors="ignore"):
    m = re.match(r"\s*LLM_PROVIDER\s*=\s*(.*)\s*$", line)
    if m:
        value = m.group(1).strip().strip('"').strip("'")
        break
print(value or "anthropic/claude-sonnet-4-20250514 (default)")
PY
)
            info "Current model: ${CURRENT}"
            echo ""
            echo "Usage: ./nexthello model <alias|provider>"
            echo "Aliases: llama4, claude, gpt4o, local"
            echo "Example: ./nexthello model openrouter/meta-llama/llama-4-maverick"
            exit 0
        fi

        case "$1" in
            llama4|llama-4|maverick|llama4-maverick)
                PROVIDER="openrouter/meta-llama/llama-4-maverick"
                ;;
            claude|claude-sonnet|sonnet)
                PROVIDER="anthropic/claude-sonnet-4-20250514"
                ;;
            gpt4o|gpt-4o)
                PROVIDER="openai/gpt-4o"
                ;;
            local|ollama|llama3|llama3.2)
                PROVIDER="ollama/llama3.2"
                ;;
            *)
                PROVIDER="$1"
                ;;
        esac

        python - "$ENV_FILE" "$PROVIDER" <<'PY'
import re
import sys

path = sys.argv[1]
provider = sys.argv[2]
ollama_base = "http://host.docker.internal:11434"

with open(path, encoding="utf-8", errors="ignore") as f:
    lines = f.readlines()

updated_provider = False
updated_ollama_api_base = False
updated_ollama_base_url = False
out = []
for line in lines:
    if re.match(r"\s*LLM_PROVIDER\s*=", line):
        out.append(f"LLM_PROVIDER={provider}\n")
        updated_provider = True
    elif re.match(r"\s*OLLAMA_API_BASE\s*=", line):
        out.append(f"OLLAMA_API_BASE={ollama_base}\n")
        updated_ollama_api_base = True
    elif re.match(r"\s*OLLAMA_BASE_URL\s*=", line):
        out.append(f"OLLAMA_BASE_URL={ollama_base}\n")
        updated_ollama_base_url = True
    else:
        out.append(line)

if not updated_provider:
    if out and not out[-1].endswith("\n"):
        out[-1] = out[-1] + "\n"
    out.append("\n# Active LLM provider\n")
    out.append(f"LLM_PROVIDER={provider}\n")

if provider.startswith("ollama/"):
    if not updated_ollama_api_base:
        out.append("OLLAMA_API_BASE=http://host.docker.internal:11434\n")
    if not updated_ollama_base_url:
        out.append("OLLAMA_BASE_URL=http://host.docker.internal:11434\n")

with open(path, "w", encoding="utf-8") as f:
    f.writelines(out)
PY

        success "Set LLM provider to ${PROVIDER}"

        if [[ "$PROVIDER" == openrouter/* ]]; then
            if ! grep -q '^OPENROUTER_API_KEY=' "$ENV_FILE"; then
                warn "OPENROUTER_API_KEY is not set in .env; model calls may fail"
            fi
        elif [[ "$PROVIDER" == ollama/* ]]; then
            info "Configured Ollama base URL: http://host.docker.internal:11434"
            if ! curl -s --max-time 2 http://localhost:11434/api/tags >/dev/null 2>&1; then
                warn "Ollama does not appear reachable on localhost:11434 from host"
            fi
        fi

        check_docker
        info "Restarting api, worker, and swarm to apply model change..."
        docker compose up -d --force-recreate api worker swarm >/dev/null
        success "Model switch applied"
        ;;

    logs)
        check_docker
        shift || true
        case "${1:-all}" in
            api)
                docker compose logs -f api
                ;;
            worker)
                docker compose logs -f worker
                ;;
            swarm)
                docker compose logs -f swarm
                ;;
            whatsapp|bridge)
                docker compose logs -f whatsapp
                ;;
            *)
                docker compose logs -f api worker swarm whatsapp
                ;;
        esac
        ;;

    whatsapp|connect)
        check_docker
        info "Preparing WhatsApp connection..."
        docker compose up -d api whatsapp >/dev/null
        echo "Fetching QR via API and waiting for connection..."
        echo ""
        docker compose exec -it api python cli.py connect --watch
        ;;

    whatsapp-test|wa-test)
        check_docker
        info "Starting WhatsApp persistence verification..."
        docker compose up -d api whatsapp >/dev/null
        echo ""
        docker compose exec -it api python cli.py whatsapp-test --timeout 240
        ;;

    whatsapp-session-test|wa-session-test)
        check_docker
        info "Starting WhatsApp session verification..."
        docker compose up -d api whatsapp >/dev/null
        echo ""
        docker compose exec -it api python cli.py whatsapp-session-test --timeout 240

        info "Restarting whatsapp container to verify restore..."
        docker compose restart whatsapp >/dev/null
        sleep 3
        docker compose exec -it api python cli.py whatsapp-session-test --timeout 90
        success "WhatsApp session persistence + restore test passed"
        ;;

    whatsapp-flow-test|wa-flow-test)
        check_docker
        info "Starting WhatsApp outbound flow test..."
        docker compose up -d api whatsapp >/dev/null

        TARGET_PHONE="7544220907"
        info "Sending test message to ${TARGET_PHONE} and verifying PostgreSQL persistence..."
        docker compose exec -it api python cli.py whatsapp-outbound-test --timeout 240 --phone "$TARGET_PHONE"
        success "WhatsApp flow test passed (outbound send + PostgreSQL persistence)"
        ;;

    swarm-response-test|swarm-test)
        check_docker
        if [ -z "${2:-}" ]; then
            error "Usage: ./nexthello swarm-response-test <phone>"
            exit 1
        fi

        TARGET_PHONE="${2}"
        shift 2 || true
        info "Starting swarm response test for ${TARGET_PHONE}..."
        docker compose up -d api swarm whatsapp >/dev/null
        docker compose exec -it api python cli.py swarm-response-test --timeout 240 --phone "$TARGET_PHONE" "$@"
        ;;

    migrate|db:migrate)
        check_docker
        info "Running database migrations..."
        docker compose up -d postgres
        sleep 2
        docker compose --profile migrations run --rm liquibase
        success "Migrations complete"
        ;;

    build)
        check_docker
        info "Building Docker images..."
        docker compose build
        success "Build complete"
        ;;

    rebuild)
        check_docker
        info "Rebuilding and restarting..."
        docker compose build
        docker compose up -d
        success "Rebuild complete"
        ;;

    shell)
        check_docker
        docker compose exec -it api bash
        ;;

    ps)
        check_docker
        docker compose ps
        ;;

    cli)
        check_docker
        shift || true
        docker compose exec api python cli.py "$@"
        ;;

    exec)
        check_docker
        shift || true
        docker compose exec api "$@"
        ;;

    help|--help|-h|"")
        cat << 'EOF'

  _   _           _   _          _ _
 | \ | | _____  _| |_| |__   ___| | | ___
 |  \| |/ _ \ \/ / __| '_ \ / _ \ | |/ _ \
 | |\  |  __/>  <| |_| | | |  __/ | | (_) |
 |_| \_|\___/_/\_\\__|_| |_|\___|_|_|\___/

  AI-powered networking assistant

USAGE:
  ./nexthello <command>

COMMANDS:
  start       Start all services
  stop        Stop all services
  restart     Restart all services
  status      Check service health
  logs        View logs (all, api, worker, swarm, whatsapp)
  model       Show or set LLM provider
  whatsapp       Connect WhatsApp (scan QR code)
  whatsapp-test  Verify fresh inbound is persisted to PostgreSQL
  whatsapp-session-test  Verify Baileys session persistence + restore
  whatsapp-flow-test  Send outbound test message + verify PostgreSQL
  swarm-response-test  Simulate inbound and verify swarm response
  migrate     Run database migrations
  build       Build Docker images
  rebuild     Build and restart
  shell       Open shell in API container
  ps          Show running containers
  cli <cmd>   Run CLI command directly
  help        Show this help

EXAMPLES:
  ./nexthello start              # Start everything
  ./nexthello whatsapp           # Connect WhatsApp and watch status
  ./nexthello whatsapp-test      # Verify inbound persistence
  ./nexthello whatsapp-session-test # Verify session persistence + restore
  ./nexthello whatsapp-flow-test # Send + verify outbound persistence
  ./nexthello swarm-response-test 17544220907 # Validate swarm response persistence
  ./nexthello logs api           # View API logs
  ./nexthello model llama4       # Switch to Llama 4 Maverick
  ./nexthello model local        # Switch to local Ollama (llama3.2)
  ./nexthello status             # Check health
  ./nexthello cli research       # Run CLI command

URLS:
  API Docs:  http://localhost:8001/docs

EOF
        ;;

    *)
        error "Unknown command: $1"
        echo "Run './nexthello help' for usage."
        exit 1
        ;;
esac
