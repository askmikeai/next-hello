{
  "name": "nexthello",
  "version": "1.0.0",
  "description": "Turn event connections into conversations. AI-powered follow-up automation with personalized videos, scheduling, and CRM sync.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexthello": "./dist/src/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && cp src/admin/dashboard.html dist/src/admin/",
    "dev": "tsc --watch",
    "start": "node dist/src/server.js",
    "cli": "node dist/src/cli/index.js",
    "setup": "node dist/src/cli/index.js setup",
    "connect": "node dist/src/cli/index.js connect",
    "connect:session1": "npx tsx scripts/connect-session.ts session-1 17542959900",
    "connect:session2": "npx tsx scripts/connect-session.ts session-2 13054272115",
    "test:sessions": "npx tsx scripts/test-two-sessions.ts",
    "test:swarm:e2e": "set -a && source .env_test && set +a && npx tsx scripts/test-swarm-e2e.ts",
    "test:swarm": "npm run test:db -- --run src/tests/integration/swarm-quality.test.ts",
    "test:swarm:live": "set -a && source .env_test && set +a && vitest run --run src/tests/integration/swarm-integration.test.ts",
    "test:e2e": "set -a && source .env_test && set +a && vitest run --run src/tests/integration/multi-agent-e2e.test.ts",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:db": "set -a && source .env_test && set +a && vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "db:migrate": "docker compose --profile migrations run --rm liquibase",
    "db:status": "docker compose --profile migrations run --rm liquibase --changelog-file=changelog.xml status",
    "db:test:init": "docker compose --profile test run --rm test-db-init",
    "db:test:migrate": "docker compose --profile test run --rm liquibase-test"
  },
  "keywords": [
    "networking",
    "automation",
    "follow-up",
    "crm",
    "heygen",
    "calendly",
    "linkedin",
    "whatsapp",
    "ai",
    "chatbot",
    "sales",
    "leads"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bullmq": "^5.0.0",
    "chalk": "^5.6.2",
    "cockatiel": "^3.1.0",
    "commander": "^14.0.3",
    "flydrive": "^1.3.0",
    "inquirer": "^13.2.2",
    "ioredis": "^5.3.0",
    "ora": "^9.3.0",
    "pino": "^8.17.0",
    "postgres": "^3.4.0",
    "prom-client": "^15.1.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^10.3.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
